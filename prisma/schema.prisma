datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  BORROWED
  RETURNED
}

model User {
  id        String     @id @default(uuid())
  clerkId   String     @unique @map("clerk_id")
  name      String
  email     String     @unique
  phone     String?
  role      Role       @default(USER)
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  addedBooks  Book[] @relation("AddedBooks")
  issuedLoans Loan[] @relation("IssuerLoans")

  @@index([clerkId])
  @@index([email])
  @@index([status])
  @@map("users")
}

model Book {
  id            String    @id @default(uuid())
  title         String
  author        String
  language      String
  genre         String?
  totalQuantity Int       @default(1) @map("total_quantity")
  description   String?
  coverUrl      String?   @map("cover_url")
  addedById     String    @map("added_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  addedBy User   @relation("AddedBooks", fields: [addedById], references: [id])
  loans   Loan[]

  @@index([title])
  @@index([deletedAt])
  @@map("books")
}

model Loan {
  id              String     @id @default(uuid())
  bookId          String     @map("book_id")
  borrowerName    String     @default("Unknown") @map("borrower_name")
  borrowerSurname String     @default("Unknown") @map("borrower_surname")
  borrowerMobile  String     @default("Unknown") @map("borrower_mobile")
  issuedById      String     @map("issued_by")
  issueDate       DateTime   @default(now()) @map("issue_date")
  dueDate         DateTime   @map("due_date")
  returnDate      DateTime?  @map("return_date")
  status          LoanStatus @default(BORROWED)
  createdAt       DateTime   @default(now()) @map("created_at")

  book     Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  issuedBy User @relation("IssuerLoans", fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([borrowerMobile])
  @@index([status])
  @@index([status, dueDate])
  @@map("loans")
}
